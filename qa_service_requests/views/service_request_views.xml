<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_service_request_list" model="ir.ui.view">
        <field name="name">qa.service.request.list</field>
        <field name="model">qa.service.request</field>
        <field name="arch" type="xml">
            <list decoration-danger="priority == '2'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="priority" widget="priority"/>
                <field name="amount" sum="Total"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_service_request_form" model="ir.ui.view">
        <field name="name">qa.service.request.form</field>
        <field name="model">qa.service.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Start" invisible="state != 'new'" class="btn-primary"/>
                    <button name="action_done" type="object" string="Done" invisible="state != 'in_progress'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('done', 'cancel')"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="sale_order_id"/>
                            <field name="user_id"/>
                            <field name="reference"/>
                        </group>
                        <group>
                            <field name="priority" widget="priority"/>
                            <field name="hours" widget="float_time"/>
                            <field name="hourly_rate"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount"/>
                            <field name="partner_request_count"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_service_request_search" model="ir.ui.view">
        <field name="name">qa.service.request.search</field>
        <field name="model">qa.service.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <filter name="my" string="My Requests" domain="[('user_id', '=', uid)]"/>
                <filter name="open" string="Open" domain="[('state', 'in', ('new', 'in_progress'))]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_service_request" model="ir.actions.act_window">
        <field name="name">Service Requests</field>
        <field name="res_model">qa.service.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>
    <menuitem id="menu_service_root" name="Service Requests" sequence="40"/>
    <menuitem id="menu_service_request" parent="menu_service_root" action="action_service_request" sequence="10"/>
</odoo>
