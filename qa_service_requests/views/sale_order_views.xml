<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_service" model="ir.ui.view">
        <field name="name">sale.order.form.service</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_service_requests" type="object" class="oe_stat_button" icon="fa-wrench" invisible="service_request_count == 0">
                    <field name="service_request_count" widget="statinfo" string="Service Requests"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
